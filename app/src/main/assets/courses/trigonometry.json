    {
      "id": "ratios",
      "title": {
        "gn-PY": "Seno, coseno ha tangente",
        "es": "Seno, coseno y tangente"
      },
      "objective": {
        "gn-PY": "Eipuru lado-kuéra rehegua jeporupy ha ehai seno, coseno ha tangente.",
        "es": "Usa las relaciones entre los lados para calcular seno, coseno y tangente."
      },
      "theory": [
        {
          "type": "text",
          "body": {
            "gn-PY": "Jahechávo peteĩ ángulo agudo, seno ombojoja pe lado opuesto ha hipotenusa. Coseno ombojoja pe lado adyacente ha hipotenusa. Tangente ombojoja opuesto ha adyacente.",
            "es": "Para un ángulo agudo, el seno relaciona el lado opuesto con la hipotenusa. El coseno relaciona el adyacente con la hipotenusa. La tangente relaciona los lados opuesto y adyacente."
          }
        },
        {
          "type": "formula",
          "body": {
            "gn-PY": "sen θ = opuesto / hipotenusa · cos θ = adyacente / hipotenusa · tan θ = opuesto / adyacente",
            "es": "sen θ = opuesto / hipotenusa · cos θ = adyacente / hipotenusa · tan θ = opuesto / adyacente"
          }
        }
      ],

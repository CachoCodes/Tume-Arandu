    {
      "id": "angles",
      "title": "Ángulo ha medida",
      "objective": "Eikuaa mba'éichapa oñemedi ángulo ha mba'épa he'ise ángulo recto.",
      "xpReward": 100,
      "theory": [
        {
          "type": "text",
          "body": "Ángulo oñeforma mokõi rayo oñepyrũva peteĩ punto-pe. Upe punto héra vértice."
        },
        {
          "type": "formula",
          "body": "90° = ángulo recto · 180° = ángulo llano"
        }
      ],
      "exercises": [
        {
          "id": "angles-choice",
          "type": "multiple_choice",
          "prompt": "Mboy grado oguereko peteĩ ángulo recto?",
          "hint": "Ejesareko pe fórmula rehegua-pe.",
          "solutionSteps": [
            "Ángulo recto ha'e peteĩ cuarto de vuelta.",
            "Peteĩ vuelta oguereko 360°, upévare 360° ÷ 4 = 90°."
          ],
          "options": [
            {
              "id": "45",
              "text": "45°"
            },
            {
              "id": "90",
              "text": "90°"
            },
            {
              "id": "180",
              "text": "180°"
            }
          ],
          "correctOptionId": "90"
        },
        {
          "id": "angles-input",
          "type": "input",
          "prompt": "Emoĩ número-pe: mboy grado oguereko peteĩ ángulo llano?",
          "hint": "Ha'e peteĩ media vuelta.",
          "solutionSteps": [
            "Peteĩ vuelta oguereko 360°.",
            "Media vuelta ha'e 360° ÷ 2 = 180°."
          ],
          "acceptedAnswers": [
            "180",
            "180°"
          ]
        },
        {
          "id": "angles-match",
          "type": "matching",

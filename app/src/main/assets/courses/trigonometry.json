    {
      "id": "notable-angles",
      "title": "Ángulo ojekuaavéva",
      "objective": "Emomandu'a umi razón trigonométrica 30°, 45° ha 60° rehegua.",
      "xpReward": 100,
      "theory": [
        {
          "type": "text",
          "body": "Oĩ ángulo jepivegua oguerekóva seno ha coseno jaikuaámava. Ko'ã valor oipytyvõ japilla hag̃ua ambue problema."
        },
        {
          "type": "formula",
          "body": "sen 30° = 1/2 · cos 60° = 1/2 · sen 45° = √2/2"
        }
      ],
      "exercises": [
        {
          "id": "notable-30",
          "type": "multiple_choice",
          "prompt": "Mba'épa sen 30°?",
          "hint": "Peteĩva umi valor oĩva teoría-pe.",
          "solutionSteps": [
            "Ángulo 30° rehegua valor jaikuaáva ha'e 1/2.",
            "Upévare sen 30° = 1/2 = 0.5."
          ],
          "options": [
            {
              "id": "half",
              "text": "1/2"
            },
            {
              "id": "one",
              "text": "1"
            },
            {
              "id": "root-two",
              "text": "√2/2"
            }
          ],
          "correctOptionId": "half"
        },
        {
          "id": "notable-60",
          "type": "input",
          "prompt": "Mba'épa cos 60°? Ehai fracción ramo.",
          "hint": "Cos 60° ha sen 30° oguereko peteĩchagua valor.",
          "solutionSteps": [
            "Cos 60° = sen 30°.",
            "Sen 30° = 1/2, upévare cos 60° = 1/2."
          ],
          "acceptedAnswers": [
            "1/2",
            "0.5"
          ]
        },
        {
          "id": "notable-rationalization",
          "type": "step_by_step",
          "prompt": "Emohai sen 45° = 1/√2 denominador racional reheve.",
          "hint": "Emboheta pe numerador ha denominador rehe √2.",
          "solutionSteps": [
            "1/√2 × √2/√2 = √2/2."
          ],
          "steps": [
            {
              "prompt": "Emoracionalisa 1/√2.",
              "acceptedAnswers": [
                "√2/2",
                "sqrt(2)/2"
              ],
              "explanation": "1/√2 × √2/√2 = √2/2."
            }
          ]
        }
      ]
    },
    {
      "id": "ratio-relations",
      "title": "Joaju seno ha coseno rehegua",
      "objective": "Eipuru joaju sen² θ + cos² θ = 1 ha eheka tangente.",
      "xpReward": 100,
      "theory": [
        {
          "type": "text",
          "body": "Peteĩ ángulo agudo rehegua seno ha coseno oñondive oĩ peteĩ joaju iporãvape. Ikatu avei jajuhu tangente jaikuaáma ramo mokõive razón."
        },
        {
          "type": "formula",
          "body": "sen² θ + cos² θ = 1  ·  tan θ = sen θ / cos θ"
        }
      ],
      "exercises": [
        {
          "id": "identity-choice",
          "type": "multiple_choice",
          "prompt": "Máva joaju piko oĩ porã opa ángulo θ-pe?",
          "hint": "Seno ha coseno cuadrado-kuéra suma ha'e peteĩ.",
          "solutionSteps": [
            "Joaju fundamental trigonometría rehegua ha'e sen² θ + cos² θ = 1."
          ],
          "options": [
            {
              "id": "right",
              "text": "sen² θ + cos² θ = 1"
            },
            {
              "id": "wrong",
              "text": "sen θ + cos θ = 1"
            },
            {
              "id": "other",
              "text": "sen² θ − cos² θ = 1"
            }
          ],
          "correctOptionId": "right"
        },
        {
          "id": "identity-input",
          "type": "input",
          "prompt": "Sen θ = 3/5 ha cos θ = 4/5. Mba'épa tan θ?",
          "hint": "Tangente = seno / coseno.",
          "solutionSteps": [
            "tan θ = sen θ / cos θ.",
            "(3/5) ÷ (4/5) = (3/5) × (5/4) = 3/4."
          ],
          "acceptedAnswers": [
            "3/4"
          ]
        },
        {
          "id": "identity-match",
          "type": "matching",
          "prompt": "Embojoaju fórmula ha hembiapo.",
          "hint": "Seno cuadrado ha coseno cuadrado joaju fundamental.",
          "solutionSteps": [
            "sen² + cos² = 1 ha'e joaju fundamental.",
            "tan θ = sen θ / cos θ."
          ],
          "leftItems": [
            {
              "id": "identity",
              "text": "sen² θ + cos² θ = 1"
            },
            {
              "id": "tangent",
              "text": "tan θ"
            }
          ],
          "rightItems": [
            {
              "id": "fundamental",
              "text": "Joaju fundamental"
            },
            {
              "id": "quotient",
              "text": "sen θ / cos θ"
            }
          ],
          "pairs": [
            {
              "leftId": "identity",
              "rightId": "fundamental"
            },
            {
              "leftId": "tangent",
              "rightId": "quotient"
            }
          ]
        }

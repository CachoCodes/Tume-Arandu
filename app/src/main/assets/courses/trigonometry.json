    {
      "id": "ratios",
      "title": "Seno, coseno ha tangente",
      "objective": "Eipuru lado-kuéra rehegua jeporupy ha ehai seno, coseno ha tangente.",
      "xpReward": 100,
      "theory": [
        {
          "type": "text",
          "body": "Jahechávo peteĩ ángulo agudo, seno ombojoja pe lado opuesto ha hipotenusa. Coseno ombojoja pe lado adyacente ha hipotenusa. Tangente ombojoja opuesto ha adyacente."
        },
        {
          "type": "formula",
          "body": "sen θ = opuesto / hipotenusa · cos θ = adyacente / hipotenusa · tan θ = opuesto / adyacente"
        }
      ],
      "exercises": [
        {
          "id": "ratios-sine",
          "type": "input",
          "prompt": "Pe lado opuesto ha'e 3 ha hipotenusa 5. Mba'épa seno? Ehai fracción ramo.",
          "hint": "Seno = opuesto / hipotenusa.",
          "solutionSteps": [
            "Eipuru sen θ = opuesto / hipotenusa.",
            "Sen θ = 3/5."
          ],
          "acceptedAnswers": [
            "3/5"
          ]
        },
        {
          "id": "ratios-cosine",
          "type": "multiple_choice",
          "prompt": "Pe adyacente ha'e 4, hipotenusa 5. Mba'épa coseno?",
          "hint": "Coseno ombojoja adyacente ha hipotenusa.",
          "solutionSteps": [
            "Coseno = adyacente / hipotenusa.",
            "Cos θ = 4/5."
          ],
          "options": [
            {
              "id": "a",
              "text": "3/4"
            },
            {
              "id": "b",
              "text": "4/5"
            },
            {
              "id": "c",
              "text": "5/4"
            }
          ],
          "correctOptionId": "b"
        },
        {
          "id": "ratios-match",
          "type": "matching",
          "prompt": "Embojoaju pe razón ha umi lado ojepurúva.",
          "hint": "Mandu'a: sen oñepyrũ opuesto reheve.",
          "solutionSteps": [
            "sen = opuesto / hipotenusa.",
            "cos = adyacente / hipotenusa; tan = opuesto / adyacente."
          ],
          "leftItems": [
            {
              "id": "sin",
